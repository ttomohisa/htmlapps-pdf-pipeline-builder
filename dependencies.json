{
  "$schema": "./schemas/dependencies.schema.json",
  "dependencies": [
    {
      "id": "pdf-lib",
      "package": "pdf-lib",
      "version": "1.17.1",
      "license": "MIT",
      "homepage": "https://pdf-lib.js.org/",
      "assets": [
        {
          "key": "runtime",
          "path": "dist/pdf-lib.min.js",
          "mime": "text/javascript",
          "stripSourceMapComment": true,
          "compression": "none"
        }
      ],
      "updates": {
        "enabled": true,
        "policy": "manual"
      }
    }
  ]
}
